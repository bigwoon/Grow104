# SS Garden App Backend Environment Variables
# Copy this file to .env.local and fill in your credentials.

# ─── Database (NeonDB) ──────────────────────────────────────────────────────
# Use the pooler endpoint (port 6543 / pgbouncer) for DATABASE_URL to prevent
# connection exhaustion in Vercel serverless. Use the direct endpoint for
# DIRECT_URL so Prisma migrations run without proxy limitations.
DATABASE_URL="postgresql://neondb_owner:<PASSWORD>@ep-xxx-pooler.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=10&pool_timeout=10"
DIRECT_URL="postgresql://neondb_owner:<PASSWORD>@ep-xxx.neon.tech/neondb?sslmode=require"

# ─── JWT Secrets ─────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="<generate-a-random-64-char-hex-string>"
JWT_REFRESH_SECRET="<generate-a-different-random-64-char-hex-string>"

# ─── Cloudinary (Image / Media Storage) ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME="<your-cloudinary-cloud-name>"
CLOUDINARY_API_KEY="<your-cloudinary-api-key>"
CLOUDINARY_API_SECRET="<your-cloudinary-api-secret>"

# ─── Rate Limiting (Upstash Redis) ───────────────────────────────────────────
# REQUIRED for production. Without these, rate limiting uses an in-memory Map
# which is NOT shared across Vercel lambda instances and provides no real
# brute-force protection at scale.
# Create a free Redis database at https://upstash.com/
UPSTASH_REDIS_REST_URL="https://<your-upstash-instance>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<your-upstash-rest-token>"

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Frontend URL allowed by CORS (no trailing slash)
FRONTEND_URL="https://www.grow104.org"

# ─── Google Maps (Deprecated — using Nominatim/OSM, no key required) ──────────
# GOOGLE_MAPS_API_KEY=
