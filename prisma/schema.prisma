generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                @id @default(uuid())
  email                     String                @unique
  password                  String
  name                      String
  role                      String
  avatarUrl                 String?
  zipcode                   String?
  phone                     String?
  address                   String?
  growing                   String[]              @default([])
  isOnline                  Boolean               @default(false)
  isActive                  Boolean               @default(true)
  lastSeen                  DateTime              @default(now())
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  eventRegistrations        EventRegistration[]
  createdEvents             Event[]               @relation("CreatedEvents")
  gardenGardeners           GardenGardener[]
  sentGardenInvitations     GardenInvitation[]    @relation("SentGardenInvitations")
  receivedGardenInvitations GardenInvitation[]    @relation("ReceivedGardenInvitations")
  gardenVolunteers          GardenVolunteer[]
  gardenerRequests          GardenerRequest[]
  ownedGardens              Garden[]              @relation("GardenOwner")
  sentInvitations           Invitation[]          @relation("SentInvitations")
  sentMessages              Message[]             @relation("SentMessages")
  receivedMessages          Message[]             @relation("ReceivedMessages")
  notifications             Notification[]
  reports                   Report[]
  createdSeedlings          SeedlingItem[]        @relation("CreatedSeedlings")
  createdSupplies           SupplyItem[]          @relation("CreatedSupplies")
  tasks                     Task[]
  volunteerAssignments      VolunteerAssignment[]
  volunteerRequests         VolunteerRequest[]
  assignedEventTasks        EventTask[]           @relation("AssignedEventTasks")

  @@map("users")
}

model Garden {
  id                String             @id @default(uuid())
  name              String
  address           String
  description       String?
  plotSize          String?
  sunlight          String?
  latitude          Decimal?           @db.Decimal(10, 8)
  longitude         Decimal?           @db.Decimal(11, 8)
  zipcode           String?
  status            String             @default("active")
  ownerId           String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  events            Event[]
  gardenGardeners   GardenGardener[]
  gardenInventories GardenInventory[]
  gardenInvitations GardenInvitation[]
  gardenVolunteers  GardenVolunteer[]
  owner             User               @relation("GardenOwner", fields: [ownerId], references: [id])
  reports           Report[]
  tasks             Task[]
  volunteerRequests VolunteerRequest[]

  @@map("gardens")
}

model GardenGardener {
  id         String   @id @default(uuid())
  gardenId   String
  userId     String
  assignedAt DateTime @default(now())
  garden     Garden   @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gardenId, userId])
  @@map("garden_gardeners")
}

model GardenVolunteer {
  id         String   @id @default(uuid())
  gardenId   String
  userId     String
  assignedAt DateTime @default(now())
  garden     Garden   @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gardenId, userId])
  @@map("garden_volunteers")
}

model Message {
  id          String    @id @default(uuid())
  fromUserId  String
  toUserId    String
  subject     String
  content     String
  requestType String?
  read        Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  fromUser    User      @relation("SentMessages", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User      @relation("ReceivedMessages", fields: [toUserId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Event {
  id              String              @id @default(uuid())
  title           String
  description     String
  gardenId        String
  date            DateTime
  startTime       String
  endTime         String
  location        String?
  maxParticipants Int?
  createdBy       String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  type            String
  requestId       String?
  tasks           EventTask[]
  registrations   EventRegistration[]
  creator         User                @relation("CreatedEvents", fields: [createdBy], references: [id])
  garden          Garden              @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  request         GardenerRequest?    @relation("ConvertedEvent", fields: [requestId], references: [id], onDelete: SetNull)

  @@map("events")
}

model EventRegistration {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  status    String   @default("registered")
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_registrations")
}

model EventTask {
  id          String   @id @default(uuid())
  eventId     String
  title       String
  description String?
  assignedTo  String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignedUser User?   @relation("AssignedEventTasks", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@map("event_tasks")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model VolunteerRequest {
  id            String                @id @default(uuid())
  gardenId      String
  requesterId   String
  title         String
  description   String
  date          DateTime
  status        String                @default("open")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  time          String?
  location      String?
  task          String?
  maxVolunteers Int                   @default(1)
  skills        String[]              @default([])
  priority      String                @default("medium")
  assignments   VolunteerAssignment[]
  garden        Garden                @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  requester     User                  @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@map("volunteer_requests")
}

model VolunteerAssignment {
  id        String           @id @default(uuid())
  requestId String
  userId    String
  joinedAt  DateTime         @default(now())
  request   VolunteerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
  @@map("volunteer_assignments")
}

model GardenerRequest {
  id             String   @id @default(uuid())
  requesterId    String
  title          String
  description    String
  status         String   @default("pending")
  requestType    String
  supplyIds      String[] @default([])
  seedlingIds    String[] @default([])
  season         String?
  quantity       Int?
  assistanceType String?
  householdSize  Int?
  task           String?
  notes          String?
  eventId        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  requester      User     @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  convertedEvent Event[]  @relation("ConvertedEvent")

  @@map("gardener_requests")
}

model Task {
  id          String    @id @default(uuid())
  gardenId    String
  assignedTo  String
  title       String
  description String
  dueDate     DateTime?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [assignedTo], references: [id], onDelete: Cascade)
  garden      Garden    @relation(fields: [gardenId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model Report {
  id           String    @id @default(uuid())
  userId       String
  gardenId     String?
  title        String
  content      String
  type         String
  activityType String
  description  String
  hoursWorked  Decimal?  @db.Decimal(5, 2)
  rating       Int?      @db.SmallInt
  visitDate    DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  garden       Garden?   @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model Invitation {
  id         String    @id @default(uuid())
  email      String
  role       String
  token      String    @unique
  message    String?
  status     String    @default("pending")
  sentBy     String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?
  sender     User      @relation("SentInvitations", fields: [sentBy], references: [id])

  @@map("invitations")
}

model GardenInvitation {
  id          String    @id @default(uuid())
  gardenId    String
  userId      String
  invitedBy   String
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  garden      Garden    @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  inviter     User      @relation("SentGardenInvitations", fields: [invitedBy], references: [id])
  user        User      @relation("ReceivedGardenInvitations", fields: [userId], references: [id])

  @@map("garden_invitations")
}

model SupplyItem {
  id        String   @id @default(uuid())
  name        String   @unique
  description String?
  category    String
  quantity    Int?
  unit        String?
  available   Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator   User     @relation("CreatedSupplies", fields: [createdBy], references: [id])

  @@map("supply_items")
}

model SeedlingItem {
  id        String   @id @default(uuid())
  name        String   @unique
  description String?
  season      String
  available   Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator   User     @relation("CreatedSeedlings", fields: [createdBy], references: [id])

  @@map("seedling_items")
}

model Vegetable {
  id                String            @id @default(uuid())
  name              String            @unique
  category          String?
  description       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  gardenInventories GardenInventory[]

  @@map("vegetables")
}

model GardenInventory {
  id          String    @id @default(uuid())
  gardenId    String
  vegetableId String
  quantity    Int       @default(1)
  status      String    @default("growing")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  garden      Garden    @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  vegetable   Vegetable @relation(fields: [vegetableId], references: [id], onDelete: Cascade)

  @@unique([gardenId, vegetableId])
  @@map("garden_inventory")
}
